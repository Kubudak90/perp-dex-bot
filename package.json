{
    "name": "perp-dex-bot",
    "version": "1.0.0",
    "description": "Supertrend + EMA + ADX + Funding Filter stratejisi ile çalışan perpetual DEX trading botu",
    "main": "dist/index.js",
    "scripts": {
        "dev": "ts-node src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "backtest": "ts-node src/backtest.ts",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "lint": "eslint src/**/*.ts",
        "lint:fix": "eslint src/**/*.ts --fix",
        "format": "prettier --write \"src/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\"",
        "clean": "rimraf dist",
        "demo:notifications": "ts-node examples/notification-demo.ts",
        "demo:database": "ts-node examples/database-demo.ts",
        "demo:analytics": "ts-node examples/analytics-demo.ts",
        "demo:dashboard": "ts-node examples/dashboard-demo.ts"
    },
    "keywords": [
        "trading-bot",
        "perpetual",
        "dex",
        "supertrend",
        "crypto",
        "automated-trading"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "dotenv": "^16.3.1",
        "ws": "^8.16.0",
        "node-telegram-bot-api": "^0.64.0",
        "better-sqlite3": "^9.2.2"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.8",
        "@types/jest": "^29.5.11",
        "@types/node": "^20.10.0",
        "@types/node-telegram-bot-api": "^0.64.2",
        "@types/ws": "^8.5.10",
        "@typescript-eslint/eslint-plugin": "^6.15.0",
        "@typescript-eslint/parser": "^6.15.0",
        "eslint": "^8.56.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.0.1",
        "jest": "^29.7.0",
        "prettier": "^3.1.1",
        "rimraf": "^5.0.5",
        "ts-jest": "^29.1.1",
        "ts-node": "^10.9.2",
        "typescript": "^5.3.2"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}