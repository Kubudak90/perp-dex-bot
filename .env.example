# ═══════════════════════════════════════════════════════════════════════════
# PERP DEX BOT - ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────
# MODE SELECTION
# ─────────────────────────────────────────────────────────────────────────
# Options: 'paper' | 'live'
# IMPORTANT: Start with 'paper' mode for testing!
MODE=paper

# ─────────────────────────────────────────────────────────────────────────
# PAPER TRADING SETTINGS
# ─────────────────────────────────────────────────────────────────────────
PAPER_BALANCE=10000

# ─────────────────────────────────────────────────────────────────────────
# LIVE TRADING SETTINGS (Hyperliquid)
# ─────────────────────────────────────────────────────────────────────────
# WARNING: Only use these when you're ready for live trading!
# PRIVATE_KEY=your_private_key_here
# WALLET_ADDRESS=0x...

# Testnet or Mainnet
# TESTNET=true

# ─────────────────────────────────────────────────────────────────────────
# TRADING CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────
# Trading pair (e.g., BTC, ETH, SOL)
SYMBOL=BTC

# Timeframe (options: 1m, 5m, 15m, 30m, 1h, 4h)
TIMEFRAME=15m

# Leverage (1-10x recommended, be careful with high leverage!)
LEVERAGE=3

# ─────────────────────────────────────────────────────────────────────────
# STRATEGY PARAMETERS
# ─────────────────────────────────────────────────────────────────────────
# Supertrend
SUPERTREND_PERIOD=10
SUPERTREND_MULTIPLIER=3

# EMA
EMA_FAST_PERIOD=50
EMA_SLOW_PERIOD=200

# ADX
ADX_PERIOD=14
ADX_THRESHOLD=20

# Funding Filter
USE_FUNDING_FILTER=true
FUNDING_THRESHOLD=0.0005

# Volatility Regime
ATR_PERIOD=14
ATR_LOOKBACK=100
MIN_ATR_PERCENTILE=20
MAX_ATR_PERCENTILE=90

# ─────────────────────────────────────────────────────────────────────────
# RISK MANAGEMENT
# ─────────────────────────────────────────────────────────────────────────
# Maximum position size (% of equity)
MAX_POSITION_SIZE=20

# Maximum daily loss (% of equity) - bot stops trading after this
MAX_DAILY_LOSS=3

# Maximum trades per day
MAX_DAILY_TRADES=3

# Risk/Reward ratio (e.g., 1.5 = 1:1.5)
RISK_REWARD_RATIO=1.5

# Stop loss ATR multiplier
STOP_LOSS_ATR_MULTIPLIER=1.5

# Cooldown after loss (minutes)
COOLDOWN_MINUTES=30

# ─────────────────────────────────────────────────────────────────────────
# ADVANCED RISK MANAGEMENT (Optional - Phase 2)
# ─────────────────────────────────────────────────────────────────────────
# Use trailing stop loss (automatically adjusts SL as price moves in your favor)
USE_TRAILING_STOP=true

# Trailing stop distance (% from peak price)
TRAILING_STOP_DISTANCE=2

# Maximum consecutive losses before stopping
MAX_CONSECUTIVE_LOSSES=3

# Maximum portfolio heat (% of total equity at risk)
MAX_PORTFOLIO_HEAT=10

# Maximum position hold time (hours) - force close after this
MAX_HOLD_TIME_HOURS=24

# ─────────────────────────────────────────────────────────────────────────
# SLIPPAGE PROTECTION (Phase 2)
# ─────────────────────────────────────────────────────────────────────────
# Enable slippage protection
SLIPPAGE_CHECK_ENABLED=true

# Maximum allowed slippage (%)
MAX_SLIPPAGE_PERCENT=0.5

# ─────────────────────────────────────────────────────────────────────────
# DATABASE (Phase 3)
# ─────────────────────────────────────────────────────────────────────────
# Enable trade history database
ENABLE_DATABASE=true

# Database file path
DATABASE_PATH=./data/trades.db

# ─────────────────────────────────────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────────────────────────────────────
# Enable debug logging
DEBUG=false

# ─────────────────────────────────────────────────────────────────────────
# NOTIFICATIONS (Optional - Phase 3)
# ─────────────────────────────────────────────────────────────────────────
# Enable notifications
ENABLE_NOTIFICATIONS=true

# Telegram Bot (for alerts)
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id

# Discord Webhook (for alerts)
# DISCORD_WEBHOOK_URL=your_webhook_url

# Daily summary time (24-hour format, e.g., 18:00)
DAILY_SUMMARY_TIME=18:00

# ─────────────────────────────────────────────────────────────────────────
# PHASE 6A: STRATEGY ENHANCEMENTS
# ─────────────────────────────────────────────────────────────────────────
# Multi-Timeframe Confirmation
USE_MULTI_TIMEFRAME=true
MTF_REQUIRE_1H_TREND=true
MTF_REQUIRE_4H_TREND=false

# Volume Filters
USE_VOLUME_FILTER=true
VOLUME_MIN_RATIO=0.8
VOLUME_REJECT_SURGE=true

# Trading Hours (sessions: NY, LONDON, ASIA)
USE_TRADING_HOURS=true
ALLOWED_SESSIONS=NY,LONDON
AVOID_WEEKENDS=true

# ─────────────────────────────────────────────────────────────────────────
# PHASE 6B: EXIT & RISK ENHANCEMENTS
# ─────────────────────────────────────────────────────────────────────────
# Partial Profit Taking (scale-out strategy)
USE_PARTIAL_TP=true
PARTIAL_TP_LEVEL1_RR=1.0
PARTIAL_TP_LEVEL1_PERCENT=50
PARTIAL_TP_LEVEL2_RR=1.5
PARTIAL_TP_LEVEL2_PERCENT=30
PARTIAL_TP_LEVEL3_RR=2.0
PARTIAL_TP_LEVEL3_PERCENT=20

# Dynamic Stop Loss (volatility-based)
USE_DYNAMIC_SL=true
SL_MULTIPLIER_LOW=1.0
SL_MULTIPLIER_HIGH=2.0

# Market Regime Filtering
USE_MARKET_REGIME=true
SKIP_RANGING_MARKETS=true
REDUCE_IN_VOLATILE=true
VOLATILE_REDUCTION=0.5
