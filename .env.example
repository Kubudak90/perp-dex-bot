# ═══════════════════════════════════════════════════════════════════════════
# PERP DEX BOT - ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────
# MODE SELECTION
# ─────────────────────────────────────────────────────────────────────────
# Options: 'paper' | 'live'
# IMPORTANT: Start with 'paper' mode for testing!
MODE=paper

# ─────────────────────────────────────────────────────────────────────────
# PAPER TRADING SETTINGS
# ─────────────────────────────────────────────────────────────────────────
PAPER_BALANCE=10000

# ─────────────────────────────────────────────────────────────────────────
# LIVE TRADING SETTINGS (Hyperliquid)
# ─────────────────────────────────────────────────────────────────────────
# WARNING: Only use these when you're ready for live trading!
# PRIVATE_KEY=your_private_key_here
# WALLET_ADDRESS=0x...

# Testnet or Mainnet
# TESTNET=true

# ─────────────────────────────────────────────────────────────────────────
# TRADING CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────
# Trading pair (e.g., BTC, ETH, SOL)
SYMBOL=BTC

# Timeframe (options: 1m, 5m, 15m, 30m, 1h, 4h)
TIMEFRAME=15m

# Leverage (1-10x recommended, be careful with high leverage!)
LEVERAGE=3

# ─────────────────────────────────────────────────────────────────────────
# STRATEGY PARAMETERS
# ─────────────────────────────────────────────────────────────────────────
# Supertrend
SUPERTREND_PERIOD=10
SUPERTREND_MULTIPLIER=3

# EMA
EMA_FAST_PERIOD=50
EMA_SLOW_PERIOD=200

# ADX
ADX_PERIOD=14
ADX_THRESHOLD=20

# Funding Filter
USE_FUNDING_FILTER=true
FUNDING_THRESHOLD=0.0005

# Volatility Regime
ATR_PERIOD=14
ATR_LOOKBACK=100
MIN_ATR_PERCENTILE=20
MAX_ATR_PERCENTILE=90

# ─────────────────────────────────────────────────────────────────────────
# RISK MANAGEMENT
# ─────────────────────────────────────────────────────────────────────────
# Maximum position size (% of equity)
MAX_POSITION_SIZE=20

# Maximum daily loss (% of equity) - bot stops trading after this
MAX_DAILY_LOSS=3

# Maximum trades per day
MAX_DAILY_TRADES=3

# Risk/Reward ratio (e.g., 1.5 = 1:1.5)
RISK_REWARD_RATIO=1.5

# Stop loss ATR multiplier
STOP_LOSS_ATR_MULTIPLIER=1.5

# Cooldown after loss (minutes)
COOLDOWN_MINUTES=30

# ─────────────────────────────────────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────────────────────────────────────
# Enable debug logging
DEBUG=false

# ─────────────────────────────────────────────────────────────────────────
# NOTIFICATIONS (Optional)
# ─────────────────────────────────────────────────────────────────────────
# Telegram Bot (for alerts)
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id

# Discord Webhook (for alerts)
# DISCORD_WEBHOOK_URL=your_webhook_url
